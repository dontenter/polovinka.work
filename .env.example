# Lab auth (optional). If all three are set, /lab and /lab/* require login.
# Password is not stored: use LAB_PASSWORD_SALT + LAB_PASSWORD_HASH (SHA-256(salt + password)).
# Generate: node -e "const c=require('crypto'); const s=c.randomBytes(16).toString('hex'); const p='YOUR_PASSWORD'; console.log('LAB_PASSWORD_SALT='+s); console.log('LAB_PASSWORD_HASH='+c.createHash('sha256').update(s+p).digest('hex')); console.log('LAB_SECRET='+c.randomBytes(32).toString('hex'));"
LAB_PASSWORD_SALT=
LAB_PASSWORD_HASH=
LAB_SECRET=
