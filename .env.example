# Gemini API Key for game description generation
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 Configuration (for image uploads)
# Get credentials from Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-domain.com (optional, for custom public URL)

# Server-only Supabase access for Life and the Lab assessor cabinet
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT is also supported as SUPABASE_SERVICE_ROLE_KEY
# Lab authentication (required for the assessor API in production)
LAB_PASSWORD_HASH=
LAB_PASSWORD_SALT=
LAB_SECRET=
# Generate Life authentication settings using configure-life.command
LIFE_PASSWORD_HASH=
LIFE_PASSWORD_SALT=
LIFE_SECRET=
LIFE_INGEST_SECRET=

# Daily Telegram digest — Production only. Prepared from the existing local session.
LIFE_TELEGRAM_API_ID=
LIFE_TELEGRAM_API_HASH=
LIFE_TELEGRAM_SESSION=
LIFE_TELEGRAM_CHATS=
LIFE_OPENAI_API_KEY=
CRON_SECRET=
LIFE_AUTOMATION_ENABLED=false
